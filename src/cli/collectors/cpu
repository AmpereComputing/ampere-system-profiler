#!/bin/bash

interval=${1}
sample_count=${2}
output_dir=${3}

post_process()
{
	#echo "Exit cpu status"
	#split up the CPU data
	awk '{if (NR<4) {print $0;} else {if (($0 ~ /all/) && ($0 !~ /Average/)) {print $0}} }' "${output_dir}/cpu_all.dat" > "${output_dir}/cpu.dat"
	NUM_CPUS=$(awk '{if ((($2 + 0) == $2) && ($2 > max)) max = $2; } END { print max }' "${output_dir}/cpu_all.dat")
	echo -e "CPU\t%user\t%system" > "${output_dir}/cpu_consolidated.dat"
	for (( i=0; i<=NUM_CPUS; i++ ))
	do
        	awk -v i=${i} 'BEGIN{a=0; a1=0; a2=0;}{if ($2 == i) {a=a+1; a1=a1+$3; a2=a2+$5}}END{print i "\t" a1/a "\t" a2/a}' "${output_dir}/cpu_all.dat" >> "${output_dir}/cpu_consolidated.dat"
	done
}

trap post_process EXIT SIGINT
#check for output directory
if [ -z "$output_dir" ]; then
	output_dir=$(pwd)
fi
echo "Collecting CPU data"
sar -P ALL "${interval}" "${sample_count}" > "${output_dir}/cpu_all.dat"

