#!/bin/bash

interval=${1}
sample_count=${2}
output_dir=${3}
network_interface=${4}
post_process()
{
        grep "${network_interface}" "${output_dir}/netinterface_all.dat" | grep -v "Average" >> "${output_dir}/netinterface.dat"
}

trap post_process EXIT SIGINT SIGTERM

#check for output directory
if [ -z "$output_dir" ]; then
        output_dir=$(pwd)
fi

if [ -z "${network_interface}" ]
then
	#need to find the default network
	network_interface=$(route | grep '^default' | grep -o '[^ ]*$')
fi

echo "Collecting network data"
echo -e "Time\tIFACE\trxpck/s\ttxpck/s\trxkB/s\ttxkB/s\trxcmp/s\ttxcmp/s\trxmcst/s\t%ifutil" > "${output_dir}/netinterface.dat"
sar -n DEV "${interval}" "${sample_count}" > "${output_dir}/netinterface_all.dat"

