#!/bin/bash

interval=${1}
sample_count=${2}
output_dir=${3}

#check for output directory
if [ -z "$output_dir" ]; then
        output_dir=$(pwd)
fi

echo "Collecting disk I/O data"
sar -b "${interval}" "${sample_count}" > "${output_dir}/iotransfer.dat"
